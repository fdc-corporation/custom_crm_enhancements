<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_view_form_akane" model="ir.ui.view">
        <field name="name">mail.activity.form.akane</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="crm_deadline_datetime" invisible="res_model != 'crm.lead'"/>
                <field name="crm_reminder_minutes" invisible="res_model != 'crm.lead' or not crm_deadline_datetime"/>
            </xpath>
        </field>
    </record>
</odoo>

