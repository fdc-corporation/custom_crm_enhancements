<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_kanban_akane" model="ir.ui.view">
        <field name="name">crm.lead.kanban.akane</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="highlight_color"/>
            </xpath>
            <xpath expr="//t[@t-name='menu']/field[@name='color']" position="replace"/>
            <xpath expr="//t[@t-name='card']/field[@name='contact_name']" position="after">
                <field name="job_position_id" class="text-muted" invisible="not job_position_id"/>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_form_job_position" model="ir.ui.view">
        <field name="name">crm.lead.form.job.position</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='function']" position="after">
                <field name="job_position_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="industry_id" placeholder="Seleccione una industria" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_quick_create_job_position" model="ir.ui.view">
        <field name="name">crm.lead.quick.create.job.position</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="priority">1100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='commercial_partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '=', True)]</attribute>
                <attribute name="context">{'default_is_company': True, 'default_company_type': 'company'}</attribute>
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': False}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '=', False), ('parent_id', '=', commercial_partner_id)]</attribute>
                <attribute name="context">{'default_is_company': False, 'default_type': 'contact', 'default_parent_id': commercial_partner_id}</attribute>
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': False}</attribute>
            </xpath>
            <xpath expr="//field[@name='commercial_partner_id']/ancestor::div[1]" position="after">
                <div class="d-flex align-items-center" colspan="2">
                    <i class="fa fa-industry" title="Industria"/>
                    <field name="industry_id" nolabel="1" class="o_field_highlight w-100 mb-0" placeholder="Industria" options="{'no_create': True, 'no_create_edit': True}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']/ancestor::div[1]" position="after">
                <div class="d-flex align-items-center" colspan="2">
                    <i class="fa fa-id-badge" title="Puesto de trabajo"/>
                    <field name="job_position_id" nolabel="1" class="o_field_highlight w-100 mb-0" placeholder="Puesto de trabajo" options="{'no_create': True, 'no_create_edit': True}"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_search_leads_akane" model="ir.ui.view">
        <field name="name">crm.lead.search.leads.akane</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='activities_today']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="string">Actividades de hoy</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_search_opportunities_akane" model="ir.ui.view">
        <field name="name">crm.lead.search.opportunities.akane</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='activities_today']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="string">Actividades de hoy</attribute>
            </xpath>
        </field>
    </record>
</odoo>

